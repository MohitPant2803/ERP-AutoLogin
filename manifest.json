{
  "manifest_version": 3,
  "name": "IIT KGP ERP 1-Click Login",
  "version": "1.0.0",
  "description": "Seamless 1-click login for IIT Kharagpur ERP (erp.iitkgp.ac.in) with automatic credentials, security questions, and OTP resolution.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "IIT KGP ERP 1-Click Login",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "notifications",
    "clipboardRead",
    "identity"
  ],
  "host_permissions": [
    "*://erp.iitkgp.ac.in/*",
    "*://mail.google.com/*",
    "*://*.iitkgpmail.iitkgp.ac.in/*",
    "*://iitkgpmail.iitkgp.ac.in/*",
    "*://gmail.googleapis.com/*",
    "*://oauth2.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://erp.iitkgp.ac.in/*"
      ],
      "js": [
        "crypto-util.js",
        "erp-api.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://mail.google.com/*",
        "*://*.iitkgpmail.iitkgp.ac.in/*",
        "*://iitkgpmail.iitkgp.ac.in/*"
      ],
      "js": [
        "mail-reader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "quick-login": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Trigger 1-Click ERP Login"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content.css"
      ],
      "matches": [
        "*://erp.iitkgp.ac.in/*"
      ]
    }
  ]
}
